# Supabase local dev (values printed by `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production / hosted Supabase project (configured via Vercel)
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=

# Fayda verification (#25 T21 stretch)
# ISSUER = the OIDC provider base. For the dev-only mock, point this at the
# in-app provider that ships under /mock-fayda and set FAYDA_MOCK=true.
FAYDA_ISSUER_URL=http://localhost:3000/mock-fayda
FAYDA_CLIENT_ID=marketplace-test-client
# Verify-only: FAYDA_REDIRECT_URI must exactly match the registered callback.
FAYDA_REDIRECT_URI=http://localhost:3000/verify-fayda/callback
# Set true to mount the dev-only mock eSignet provider (/mock-fayda/*) and use
# the in-memory demo client key. The production build refuses this flag.
FAYDA_MOCK=true
# Real integration (partner onboarding): the RSA private JWK from partner.fayda.et.
# Leave blank in dev — the mock path is used when FAYDA_MOCK=true.
# FAYDA_CLIENT_PRIVATE_JWK=

# Chapa sandbox payments (#97 demo to judges). Register a free test account at
# dashboard.chapa.co, then use your test secret key (CHASECK_TEST-...).
# CHAPA_SECRET_KEY=
# CHAPA_DEMO_FALLBACK=true  # simulate payments offline, no network or account
